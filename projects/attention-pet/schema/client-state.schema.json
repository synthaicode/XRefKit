{
  "$defs": {
    "ClientCapabilities": {
      "additionalProperties": false,
      "properties": {
        "activeSessionChanged": {
          "title": "Activesessionchanged",
          "type": "boolean"
        },
        "promptSubmitted": {
          "title": "Promptsubmitted",
          "type": "boolean"
        },
        "modelSelected": {
          "title": "Modelselected",
          "type": "boolean"
        },
        "fullConversationAccess": {
          "default": false,
          "title": "Fullconversationaccess",
          "type": "boolean"
        }
      },
      "required": [
        "activeSessionChanged",
        "promptSubmitted",
        "modelSelected"
      ],
      "title": "ClientCapabilities",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "evidence": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "evidence"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "constraint",
            "decision",
            "question",
            "exception",
            "history",
            "conflict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "done",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "depth": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "fixed": {
          "default": false,
          "title": "Fixed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "source"
      ],
      "title": "Item",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "validated",
            "repeated_error",
            "correction_ignored",
            "misread_explanation",
            "decision_contradiction",
            "intent_drift",
            "no_improvement",
            "repeated_failure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "context": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "evidence",
        "context"
      ],
      "title": "Observation",
      "type": "object"
    },
    "WorkingSet": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "taskId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Taskid",
          "type": "string"
        },
        "contextId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Contextid",
          "type": "string"
        },
        "observedAt": {
          "minimum": 0,
          "title": "Observedat",
          "type": "number"
        },
        "coverage": {
          "default": "partial",
          "enum": [
            "partial",
            "reviewed"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 500,
          "title": "Items",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 2000,
          "title": "Dependencies",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 500,
          "title": "Observations",
          "type": "array"
        }
      },
      "required": [
        "taskId",
        "contextId",
        "observedAt",
        "items"
      ],
      "title": "WorkingSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "attention-pet-client-v1",
      "title": "Protocolversion",
      "type": "string"
    },
    "provider": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Provider",
      "type": "string"
    },
    "clientInstanceId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Clientinstanceid",
      "type": "string"
    },
    "sessionId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    },
    "activationRevision": {
      "minimum": 0,
      "title": "Activationrevision",
      "type": "integer"
    },
    "observedAt": {
      "minimum": 0,
      "title": "Observedat",
      "type": "number"
    },
    "model": {
      "default": "",
      "maxLength": 200,
      "title": "Model",
      "type": "string"
    },
    "reasoning": {
      "default": "",
      "maxLength": 80,
      "title": "Reasoning",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/ClientCapabilities"
    },
    "workingSet": {
      "$ref": "#/$defs/WorkingSet"
    }
  },
  "required": [
    "protocolVersion",
    "provider",
    "clientInstanceId",
    "sessionId",
    "activationRevision",
    "observedAt",
    "capabilities",
    "workingSet"
  ],
  "title": "ClientState",
  "type": "object"
}
